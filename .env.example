# Codogram Environment Variables
# Copy this file to .env and fill in your values

# === Required ===

# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin user IDs (comma-separated, get via /my_chat_id)
ADMIN_IDS=123456789,987654321

# Base directory for projects
BASE_DIR=/home/user/dev

# === Optional ===

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# OpenAI API key (for voice message transcription via Whisper)
# OPENAI_API_KEY=sk-...

# OpenAI base URL (for custom endpoints like Azure)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Whisper transcription timeout in seconds
# WHISPER_TIMEOUT=60

# Whisper cost per minute in USD (for usage tracking)
# whisper-1: 0.006, gpt-4o-mini-transcribe: 0.003
# WHISPER_COST_PER_MINUTE=0.006

# === Timing (advanced, usually no need to change) ===

# PERMISSION_POLLER_DEBOUNCE=0.5
# PERMISSION_POLLER_INTERVAL=0.5
# HISTORY_WATCHER_INTERVAL=15
# SESSION_BINDING_TIMEOUT=300
# SESSION_BINDING_INTERVAL=0.5
# JSONL_WATCHER_INTERVAL=0.5
# CLAUDE_LAUNCH_TIMEOUT=120
# PROJECT_CLEANUP_DAYS=30
